        // PDF compression with PDF.js
        async function compressPDF(file, quality, dpi, targetSizeBytes) {
            return new Promise(async (resolve, reject) => {
                try {
                    const arrayBuffer = await file.arrayBuffer();
                    const loadingTask = pdfjsLib.getDocument(arrayBuffer);
                    const pdfDocument = await loadingTask.promise;
                    
                    // Create a new PDF document
                    const { PDFDocument, rgb } = PDFLib;
                    const newPdfDoc = await PDFDocument.create();
                    
                    // Copy pages with quality settings
                    const totalPages = pdfDocument.numPages;
                    const scale = dpi / 72; // PDFs are typically 72 DPI
                    
                    // If target size is specified, we'll need to adjust quality dynamically
                    if (targetSizeBytes) {
                        const result = await findOptimalPdfQuality(pdfDocument, file, dpi, targetSizeBytes);
                        resolve(result);
                        return;
                    }
                    
                    // Fixed quality compression
                    for (let i = 1; i <= totalPages; i++) {
                        const page = await pdfDocument.getPage(i);
                        const viewport = page.getViewport({ scale: scale });
                        
                        // Create a canvas for rendering
                        const canvas = document.createElement('canvas');
                        const context = canvas.getContext('2d');
                        canvas.height = viewport.height;
                        canvas.width = viewport.width;
                        
                        // Render PDF page to canvas
                        await page.render({
                            canvasContext: context,
                            viewport: viewport
                        }).promise;
                        
                        // Convert canvas to image and add to new PDF
                        const imageBytes = await new Promise(resolve => {
                            canvas.toBlob(blob => {
                                const reader = new FileReader();
                                reader.onload = () => resolve(new Uint8Array(reader.result));
                                reader.readAsArrayBuffer(blob);
                            }, 'image/jpeg', quality / 100);
                        });
                        
                        const image = await newPdfDoc.embedJpg(imageBytes);
                        const pageWidth = page.getViewport({ scale: 1.0 }).width;
                        const pageHeight = page.getViewport({ scale: 1.0 }).height;
                        
                        const newPage = newPdfDoc.addPage([pageWidth, pageHeight]);
                        newPage.drawImage(image, {
                            x: 0,
                            y: 0,
                            width: pageWidth,
                            height: pageHeight,
                        });
                    }
                    
                    // Save the new PDF
                    const pdfBytes = await newPdfDoc.save();
                    const blob = new Blob([pdfBytes], { type: 'application/pdf' });
                    
                    resolve({
                        blob: blob,
                        url: URL.createObjectURL(blob),
                        originalSize: file.size,
                        compressedSize: blob.size,
                        fileName: getOutputFileName(file.name, 'application/pdf'),
                        qualityUsed: quality
                    });
                } catch (error) {
                    reject(error);
                }
            });
        }
        
        // Find optimal quality for PDF target size
        async function findOptimalPdfQuality(pdfDocument, file, dpi, targetSizeBytes) {
            let minQuality = 10;
            let maxQuality = 90;
            let bestBlob = null;
            let bestQuality = 90;
            const tolerance = 0.05; // 5% tolerance
            
            // Helper function to test a quality level
            const testQuality = async (quality) => {
                const { PDFDocument, rgb } = PDFLib;
                const newPdfDoc = await PDFDocument.create();
                const totalPages = pdfDocument.numPages;
                const scale = dpi / 72;
                
                for (let i = 1; i <= totalPages; i++) {
                    const page = await pdfDocument.getPage(i);
                    const viewport = page.getViewport({ scale: scale });
                    
                    const canvas = document.createElement('canvas');
                    const context = canvas.getContext('2d');
                    canvas.height = viewport.height;
                    canvas.width = viewport.width;
                    
                    await page.render({
                        canvasContext: context,
                        viewport: viewport
                    }).promise;
                    
                    const imageBytes = await new Promise(resolve => {
                        canvas.toBlob(blob => {
                            const reader = new FileReader();
                            reader.onload = () => resolve(new Uint8Array(reader.result));
                            reader.readAsArrayBuffer(blob);
                        }, 'image/jpeg', quality / 100);
                    });
                    
                    const image = await newPdfDoc.embedJpg(imageBytes);
                    const pageWidth = page.getViewport({ scale: 1.0 }).width;
                    const pageHeight = page.getViewport({ scale: 1.0 }).height;
                    
                    const newPage = newPdfDoc.addPage([pageWidth, pageHeight]);
                    newPage.drawImage(image, {
                        x: 0,
                        y: 0,
                        width: pageWidth,
                        height: pageHeight,
                    });
                }
                
                const pdfBytes = await newPdfDoc.save();
                const blob = new Blob([pdfBytes], { type: 'application/pdf' });
                
                return {
                    blob: blob,
                    size: blob.size,
                    quality: quality
                };
            };
            
            // Recursive binary search
            const search = async (min, max) => {
                if (min > max) return;
                
                const mid = Math.floor((min + max) / 2);
                const result = await testQuality(mid);
                
                // Update progress
                const progress = ((maxQuality - (max - min)) / (maxQuality - minQuality)) * 100;
                document.getElementById('pdf-progress-bar').style.width = `${progress}%`;
                
                if (result.size <= targetSizeBytes * (1 + tolerance)) {
                    // Within tolerance - could be good enough
                    bestBlob = result.blob;
                    bestQuality = result.quality;
                    
                    // Try for better quality (higher)
                    await search(mid + 1, max);
                } else {
                    // Too big - need lower quality
                    await search(min, mid - 1);
                }
            };
            
            // Start search
            await search(minQuality, maxQuality);
            
            if (!bestBlob) {
                // If no solution found (shouldn't happen), use minimum quality
                const result = await testQuality(minQuality);
                return {
                    blob: result.blob,
                    url: URL.createObjectURL(result.blob),
                    originalSize: file.size,
                    compressedSize: result.blob.size,
                    fileName: getOutputFileName(file.name, 'application/pdf'),
                    qualityUsed: result.quality
                };
            } else {
                return {
                    blob: bestBlob,
                    url: URL.createObjectURL(bestBlob),
                    originalSize: file.size,
                    compressedSize: bestBlob.size,
                    fileName: getOutputFileName(file.name, 'application/pdf'),
                    qualityUsed: bestQuality
                };
            }
        }

