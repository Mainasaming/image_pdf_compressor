        // Actual image compression function
        async function compressImage(file, quality, format, targetSizeBytes) {
            return new Promise((resolve) => {
                const reader = new FileReader();
                
                reader.onload = function(event) {
                    const img = new Image();
                    img.src = event.target.result;
                    
                    img.onload = function() {
                        const canvas = document.createElement('canvas');
                        const ctx = canvas.getContext('2d');
                        
                        // Calculate new dimensions if needed
                        canvas.width = img.width;
                        canvas.height = img.height;
                        
                        // Draw image on canvas
                        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                        
                        // Determine output format
                        let mimeType = 'image/jpeg';
                        if (format === 'png') mimeType = 'image/png';
                        if (format === 'webp') mimeType = 'image/webp';
                        if (format === 'original') {
                            // Try to keep original format
                            if (file.type === 'image/png') mimeType = 'image/png';
                            if (file.type === 'image/webp') mimeType = 'image/webp';
                        }
                        
                        // If target size is specified, use binary search to find optimal quality
                        if (targetSizeBytes) {
                            findOptimalImageQuality(canvas, mimeType, file, targetSizeBytes, resolve);
                        } else {
                            // Convert quality to 0-1 range
                            const qualityValue = quality / 100;
                            
                            // Compress the image with fixed quality
                            canvas.toBlob((blob) => {
                                resolve({
                                    blob: blob,
                                    url: URL.createObjectURL(blob),
                                    originalSize: file.size,
                                    compressedSize: blob.size,
                                    fileName: getOutputFileName(file.name, mimeType),
                                    qualityUsed: quality
                                });
                            }, mimeType, qualityValue);
                        }
                    };
                };
                
                reader.readAsDataURL(file);
            });
        }

        // Binary search to find optimal quality for target size (images)
        function findOptimalImageQuality(canvas, mimeType, file, targetSizeBytes, resolve) {
            let minQuality = 10;
            let maxQuality = 100;
            let bestBlob = null;
            let bestQuality = 100;
            const tolerance = 0.05; // 5% tolerance
            
            // Helper function to test a quality level
            const testQuality = (quality) => {
                return new Promise((resolveTest) => {
                    canvas.toBlob((blob) => {
                        resolveTest({
                            blob: blob,
                            size: blob.size,
                            quality: quality
                        });
                    }, mimeType, quality / 100);
                });
            };
            
            // Recursive binary search
            const search = async (min, max) => {
                if (min > max) return;
                
                const mid = Math.floor((min + max) / 2);
                const result = await testQuality(mid);
                
                // Update progress
                const progress = ((maxQuality - (max - min)) / (maxQuality - minQuality)) * 100;
                document.getElementById('image-progress-bar').style.width = `${progress}%`;
                
                if (result.size <= targetSizeBytes * (1 + tolerance)) {
                    // Within tolerance - could be good enough
                    bestBlob = result.blob;
                    bestQuality = result.quality;
                    
                    // Try for better quality (higher)
                    await search(mid + 1, max);
                } else {
                    // Too big - need lower quality
                    await search(min, mid - 1);
                }
            };
            
            // Start search
            search(minQuality, maxQuality).then(() => {
                if (!bestBlob) {
                    // If no solution found (shouldn't happen), use minimum quality
                    testQuality(minQuality).then((result) => {
                        resolve({
                            blob: result.blob,
                            url: URL.createObjectURL(result.blob),
                            originalSize: file.size,
                            compressedSize: result.blob.size,
                            fileName: getOutputFileName(file.name, mimeType),
                            qualityUsed: result.quality
                        });
                    });
                } else {
                    resolve({
                        blob: bestBlob,
                        url: URL.createObjectURL(bestBlob),
                        originalSize: file.size,
                        compressedSize: bestBlob.size,
                        fileName: getOutputFileName(file.name, mimeType),
                        qualityUsed: bestQuality
                    });
                }
            });
        }

